<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<!-- SOC Lab Custom Rules -->
<group name="local,syslog,">

  <rule id="100010" level="10" frequency="5" timeframe="60">
    <if_matched_sid>5716</if_matched_sid>
    <description>Possible brute force: 5+ SSH auth failures in 60 seconds</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100011" level="8">
    <if_sid>80792</if_sid>
    <match>base64</match>
    <description>Suspicious: base64-encoded command execution detected</description>
    <mitre>
      <id>T1140</id>
    </mitre>
    <group>command_execution,</group>
  </rule>

  <rule id="100012" level="7">
    <if_sid>550</if_sid>
    <field name="file">watched</field>
    <description>File integrity change detected in monitored directory</description>
    <mitre>
      <id>T1565</id>
    </mitre>
    <group>syscheck,</group>
  </rule>

</group>
